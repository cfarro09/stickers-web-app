@{
    ViewData["Title"] = "Historial General de Ventas";
    var currentRole = Context.Request.Query["role"].ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <h2 class="h3 mb-1 fw-bold text-dark">Monitoreo Comercial y Ventas</h2>
        <p class="text-muted mb-0"><i class="fa-solid fa-chart-line me-1"></i> Auditoría global de lecturas y despachos en campo (Jefe de Ventas)</p>
    </div>
    <button class="btn btn-outline-primary fw-bold" onclick="showToast('Exportando reporte a Excel...', 'info')">
        <i class="fa-solid fa-file-excel me-1"></i> Exportar Reporte
    </button>
</div>

<!-- TARJETAS DE MÉTRICAS GLOBALES (KPIs) -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card metric-card border-0 shadow-sm bg-primary text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center p-3">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold small mb-1">Total Escaneos (Hoy)</h6>
                    <h3 class="mb-0 fw-bold">1,248</h3>
                </div>
                <i class="fa-solid fa-qrcode fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card metric-card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center p-3">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold small mb-1">Entregas Exitosas</h6>
                    <h3 class="mb-0 fw-bold">1,215</h3>
                </div>
                <i class="fa-solid fa-circle-check fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card metric-card border-0 shadow-sm bg-danger text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center p-3">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold small mb-1">Rechazos / Alertas</h6>
                    <h3 class="mb-0 fw-bold">33</h3>
                </div>
                <i class="fa-solid fa-triangle-exclamation fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card metric-card border-0 shadow-sm bg-dark text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center p-3">
                <div>
                    <h6 class="text-white-50 text-uppercase fw-bold small mb-1">Efectividad General</h6>
                    <h3 class="mb-0 fw-bold">97.35%</h3>
                </div>
                <i class="fa-solid fa-percent fa-2x opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- BARRA DE FILTROS DE SEGUIMIENTO -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-start-0" placeholder="Buscar por LPN o Cliente...">
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select bg-light border-0">
                    <option selected>Filtrar por Vendedor (Todos)</option>
                    <option value="1">Carlos Mendoza</option>
                    <option value="2">Ana Gómez</option>
                    <option value="3">Roberto Sánchez</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select bg-light border-0">
                    <option selected>Filtrar por Estado</option>
                    <option value="success">Despachado</option>
                    <option value="danger">Rechazado</option>
                    <option value="warning">En Espera</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="button" class="btn btn-primary fw-bold" onclick="showToast('Filtros aplicados en tiempo real', 'success')">
                    <i class="fa-solid fa-filter me-1"></i> Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- TABLA DE CONTROL Y SEGUIMIENTO GENERAL -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-list-check text-primary me-2"></i> Reporte en Tiempo Real de Escaneos por Vendedor</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted">
                    <tr>
                        <th class="ps-4 fw-semibold">Vendedor</th>
                        <th class="fw-semibold">Pedido / LPN</th>
                        <th class="fw-semibold">Cliente</th>
                        <th class="fw-semibold">Sucursal / GPS</th>
                        <th class="fw-semibold">Fecha y Hora</th>
                        <th class="fw-semibold">Estado</th>
                        <th class="text-end pe-4 fw-semibold">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    CM
                                </div>
                                <div class="fw-bold text-dark" style="font-size: 0.9rem;">Carlos Mendoza</div>
                            </div>
                        </td>
                        <td><code class="fw-semibold text-primary">QR-990145-LPN</code></td>
                        <td><span class="text-dark fw-semibold">Retail del Norte S.A.</span></td>
                        <td><span class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i> Miraflores</span></td>
                        <td><span class="text-muted small">Hace 2 mins (10:55 AM)</span></td>
                        <td><span class="badge bg-success rounded-pill px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i> Despachado</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-light border" onclick="showToast('Mostrando detalle de geolocalización', 'info')">
                                <i class="fa-solid fa-map-location-dot"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    AG
                                </div>
                                <div class="fw-bold text-dark" style="font-size: 0.9rem;">Ana Gómez</div>
                            </div>
                        </td>
                        <td><code class="fw-semibold text-primary">QR-990142-LPN</code></td>
                        <td><span class="text-dark fw-semibold">ElectroHogar S.A.C.</span></td>
                        <td><span class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i> San Isidro</span></td>
                        <td><span class="text-muted small">Hace 12 mins (10:45 AM)</span></td>
                        <td><span class="badge bg-success rounded-pill px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i> Despachado</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-light border" onclick="showToast('Mostrando detalle de geolocalización', 'info')">
                                <i class="fa-solid fa-map-location-dot"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    RS
                                </div>
                                <div class="fw-bold text-dark" style="font-size: 0.9rem;">Roberto Sánchez</div>
                            </div>
                        </td>
                        <td><code class="fw-semibold text-primary">QR-880221-LPN</code></td>
                        <td><span class="text-dark fw-semibold">Distribuidora Lima</span></td>
                        <td><span class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i> Surco</span></td>
                        <td><span class="text-muted small">Hace 34 mins (10:23 AM)</span></td>
                        <td><span class="badge bg-danger rounded-pill px-2 py-1"><i class="fa-solid fa-circle-xmark me-1"></i> Rechazado</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-light border text-danger" onclick="showToast('Alerta: Código QR no registrado', 'danger')">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    CM
                                </div>
                                <div class="fw-bold text-dark" style="font-size: 0.9rem;">Carlos Mendoza</div>
                            </div>
                        </td>
                        <td><code class="fw-semibold text-primary">QR-990110-LPN</code></td>
                        <td><span class="text-dark fw-semibold">Supermercados Metro</span></td>
                        <td><span class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i> Chorrillos</span></td>
                        <td><span class="text-muted small">Hace 1 hora (09:50 AM)</span></td>
                        <td><span class="badge bg-success rounded-pill px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i> Despachado</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-light border" onclick="showToast('Mostrando detalle de geolocalización', 'info')">
                                <i class="fa-solid fa-map-location-dot"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
