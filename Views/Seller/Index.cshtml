@{
    ViewData["Title"] = "Módulo Vendedor - Lector QR";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <h2 class="h3 mb-1 fw-bold text-dark">Lectura de Pedidos QR</h2>
        <p class="text-muted mb-0"><i class="fa-solid fa-qrcode me-1"></i> Escaneo y verificación de despachos</p>
    </div>
</div>

<div class="row">
    <!-- Panel del Lector QR -->
    <div class="col-lg-7 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-camera text-primary me-2"></i> Escáner Activo</h6>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1"><i class="fa-solid fa-circle-dot me-1" style="font-size: 0.6rem;"></i> En línea</span>
            </div>
            <div class="card-body p-4 bg-light d-flex flex-column align-items-center justify-content-center" style="min-height: 400px; border-radius: 0 0 0.5rem 0.5rem;">
                
                <!-- Simulación visual de cámara -->
                <div class="position-relative bg-dark rounded shadow-sm d-flex align-items-center justify-content-center overflow-hidden" style="width: 100%; max-width: 380px; aspect-ratio: 1; border: 4px solid #334155;">
                    <!-- Línea de escaneo animada -->
                    <div class="w-100 position-absolute" style="height: 2px; background-color: #22c55e; box-shadow: 0 0 10px 2px #22c55e; animation: scan 2s infinite ease-in-out; top: 0;"></div>
                    
                    <i class="fa-solid fa-qrcode text-secondary opacity-25" style="font-size: 8rem;"></i>
                    
                    <!-- Esquinas del visor -->
                    <div class="position-absolute" style="top: 20px; left: 20px; width: 30px; height: 30px; border-top: 3px solid #22c55e; border-left: 3px solid #22c55e;"></div>
                    <div class="position-absolute" style="top: 20px; right: 20px; width: 30px; height: 30px; border-top: 3px solid #22c55e; border-right: 3px solid #22c55e;"></div>
                    <div class="position-absolute" style="bottom: 20px; left: 20px; width: 30px; height: 30px; border-bottom: 3px solid #22c55e; border-left: 3px solid #22c55e;"></div>
                    <div class="position-absolute" style="bottom: 20px; right: 20px; width: 30px; height: 30px; border-bottom: 3px solid #22c55e; border-right: 3px solid #22c55e;"></div>
                </div>

                <div class="mt-4 text-center">
                    <p class="text-muted fw-semibold mb-2">Apunta el código QR del bulto a la cámara</p>
                    <div class="input-group mx-auto shadow-sm" style="max-width: 380px;">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-keyboard text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="O ingresa el código manual..." autofocus>
                        <button class="btn btn-primary fw-bold" onclick="showToast('Código verificado con éxito en el sistema.', 'success')">Verificar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Panel de Resultados y Últimos Escaneos -->
    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-bottom-0">
                <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i> Historial Reciente</h6>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                        <div>
                            <div class="fw-bold text-dark">QR-990145-LPN</div>
                            <small class="text-muted"><i class="fa-solid fa-user me-1"></i> Cliente: Retail del Norte</small>
                        </div>
                        <span class="badge bg-success rounded-pill"><i class="fa-solid fa-check me-1"></i> Despachado</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                        <div>
                            <div class="fw-bold text-dark">QR-990142-LPN</div>
                            <small class="text-muted"><i class="fa-solid fa-user me-1"></i> Cliente: ElectroHogar</small>
                        </div>
                        <span class="badge bg-success rounded-pill"><i class="fa-solid fa-check me-1"></i> Despachado</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center p-3 bg-light">
                        <div>
                            <div class="fw-bold text-danger">QR-880221-LPN</div>
                            <small class="text-muted"><i class="fa-solid fa-triangle-exclamation text-danger me-1"></i> Error: Código no registrado</small>
                        </div>
                        <span class="badge bg-danger rounded-pill">Rechazado</span>
                    </li>
                </ul>
            </div>
            <div class="card-footer bg-white text-center py-3 border-top-0">
                <a href="#" class="text-decoration-none fw-bold small text-primary">Ver todos los escaneos del día <i class="fa-solid fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes scan {
        0% { top: 10%; opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { top: 90%; opacity: 0; }
    }
</style>
