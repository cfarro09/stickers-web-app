@{
    ViewData["Title"] = "Dashboard Logístico";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
    <div>
        <h2 class="h3 mb-1 fw-bold text-dark">Dashboard Operativo</h2>
        <p class="text-muted mb-0"><i class="fa-solid fa-calendar-day me-1"></i> Resumen de impresión en tiempo real</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <select class="form-select border-secondary shadow-sm" aria-label="Filtro Operador" onchange="actualizarGraficos()">
            <option selected>Todos los Operadores</option>
            <option value="1">Carlos Mendoza</option>
            <option value="2">Ana Gómez</option>
        </select>
        <select class="form-select border-secondary shadow-sm" aria-label="Filtro Mesa" onchange="actualizarGraficos()">
            <option selected>Todas las Mesas</option>
            <option value="1">Mesa Embalaje A1</option>
            <option value="2">Mesa Embalaje B2</option>
        </select>
        <select class="form-select border-secondary shadow-sm" aria-label="Filtro Máquina" onchange="actualizarGraficos()">
            <option selected>Todas las Máquinas</option>
            <option value="1">Epson CW-C4000 (01)</option>
            <option value="2">Zebra ZT411 (02)</option>
        </select>
    </div>
</div>

<!-- Sección 1: Producción de Impresión Estándar -->
<div class="mb-3">
    <h5 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-industry me-2 text-primary"></i>Producción de Impresión Estándar</h5>
</div>
<div class="row mb-4">
    <!-- Stickers Usados/Planificados -->
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card metric-card border-0 shadow-sm border-start border-primary border-4 h-100 py-2 bg-white">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-primary text-uppercase mb-1" style="font-size: 0.75rem;">Stickers (Usados / Meta)</div>
                        <div class="h4 mb-0 fw-bold text-dark" id="metric-stickers">4,520 <span class="text-muted fs-6 fw-normal">/ 5,000</span></div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" id="metric-stickers-progress" role="progressbar" style="width: 90%" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-tags icon-large text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Acumulado del Día (Normal) -->
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card metric-card border-0 shadow-sm border-start border-success border-4 h-100 py-2 bg-white">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-success text-uppercase mb-1" style="font-size: 0.75rem;">Impresiones del Día (Estándar)</div>
                        <div class="h4 mb-0 fw-bold text-dark" id="metric-acumulado">1,250 <span class="text-muted fs-6 fw-normal">Und.</span></div>
                        <div class="mt-2 text-success" id="metric-acumulado-trend" style="font-size: 0.8rem;">
                            <i class="fa-solid fa-arrow-trend-up me-1"></i> 12% más que ayer
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-boxes-packing icon-large text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Acumulado del Mes (Normal) -->
    <div class="col-xl-4 col-md-12 mb-4">
        <div class="card metric-card border-0 shadow-sm border-start border-info border-4 h-100 py-2 bg-white">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-info text-uppercase mb-1" style="font-size: 0.75rem;">Impresiones del Mes (Estándar)</div>
                        <div class="h4 mb-0 fw-bold text-dark">35,400 <span class="text-muted fs-6 fw-normal">Und.</span></div>
                        <div class="mt-2 text-muted" style="font-size: 0.8rem;">
                            <i class="fa-solid fa-calendar-check me-1"></i> Mes Actual
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-calendar-alt icon-large text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sección 2: Control de Reimpresiones e Incidencias -->
<div class="mb-3">
    <h5 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-rotate-right me-2 text-danger"></i>Control de Reimpresiones e Incidencias</h5>
</div>
<div class="row mb-4">
    <!-- Solicitudes Pendientes -->
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card metric-card border-0 shadow-sm border-start border-danger border-4 h-100 py-2 bg-white">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-danger text-uppercase mb-1" style="font-size: 0.75rem;">Aprobaciones Pendientes</div>
                        <div class="h4 mb-0 fw-bold text-danger" id="metric-reimpresiones">12 <span class="text-muted fs-6 fw-normal">Alertas</span></div>
                        <div class="mt-2 text-danger fw-bold" style="font-size: 0.8rem;">
                            <i class="fa-solid fa-circle-exclamation me-1"></i> Requieren atención
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-triangle-exclamation icon-large text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reimpresiones del Día -->
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card metric-card border-0 shadow-sm border-start border-warning border-4 h-100 py-2 bg-white">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-warning text-uppercase mb-1" style="font-size: 0.75rem;">Reimpresiones del Día</div>
                        <div class="h4 mb-0 fw-bold text-dark" id="metric-reimpresiones-dia">84 <span class="text-muted fs-6 fw-normal">Und.</span></div>
                        <div class="mt-2 text-muted" style="font-size: 0.8rem;">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i> Hoy
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-redo icon-large text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reimpresiones del Mes -->
    <div class="col-xl-4 col-md-12 mb-4">
        <div class="card metric-card border-0 shadow-sm border-start border-dark border-4 h-100 py-2 bg-white">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs fw-bold text-dark text-uppercase mb-1" style="font-size: 0.75rem;">Reimpresiones del Mes</div>
                        <div class="h4 mb-0 fw-bold text-dark" id="metric-reimpresiones-mes">1,820 <span class="text-muted fs-6 fw-normal">Und.</span></div>
                        <div class="mt-2 text-muted" style="font-size: 0.8rem;">
                            <i class="fa-solid fa-chart-bar me-1"></i> Acumulado mensual
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fa-solid fa-chart-line icon-large text-dark"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos -->
<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header py-3 bg-white border-bottom-0 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-chart-line text-primary me-2"></i>Volumen de Impresión Diario (Evolución por Hora)</h6>
                <button class="btn btn-sm btn-light border" onclick="showToast('Descargando reporte PDF...', 'success')"><i class="fa-solid fa-download"></i></button>
            </div>
            <div class="card-body bg-white rounded-bottom m-3 mt-0 border" style="height: 320px; position: relative;">
                <canvas id="areaChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header py-3 bg-white border-bottom-0">
                <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-chart-pie text-success me-2"></i>Stickers por Material</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center bg-white rounded-bottom m-3 mt-0 border" style="height: 320px; position: relative;">
                <canvas id="doughnutChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let areaChartInstance;
        let doughnutChartInstance;

        document.addEventListener('DOMContentLoaded', function () {
            initCharts();
        });

        function initCharts() {
            // Datos del Gráfico de Área (Evolución por hora)
            const ctxArea = document.getElementById('areaChart').getContext('2d');
            areaChartInstance = new Chart(ctxArea, {
                type: 'line',
                data: {
                    labels: ['08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00'],
                    datasets: [{
                        label: 'Etiquetas Impresas',
                        data: [150, 300, 450, 400, 200, 350, 500, 600, 480],
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderColor: 'rgba(59, 130, 246, 1)',
                        borderWidth: 2,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: 'rgba(59, 130, 246, 1)',
                        pointRadius: 4,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { mode: 'index', intersect: false }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { borderDash: [2, 4] } },
                        x: { grid: { display: false } }
                    }
                }
            });

            // Datos del Gráfico de Anillo (Distribución por material)
            const ctxDoughnut = document.getElementById('doughnutChart').getContext('2d');
            doughnutChartInstance = new Chart(ctxDoughnut, {
                type: 'doughnut',
                data: {
                    labels: ['Estándar (Normal)', 'Resistente a Aceites'],
                    datasets: [{
                        data: [75, 25],
                        backgroundColor: ['#3b82f6', '#10b981'],
                        hoverOffset: 4,
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } }
                    }
                }
            });
        }

        // Simulación de interactividad al cambiar filtros
        function actualizarGraficos() {
            showToast('Actualizando datos según filtros...', 'info');
            
            // Simular carga aleatoria con un timeout para simular la red
            setTimeout(() => {
                // Actualizar gráfica de línea
                const newDataArea = Array.from({length: 9}, () => Math.floor(Math.random() * 600) + 100);
                areaChartInstance.data.datasets[0].data = newDataArea;
                areaChartInstance.update();

                // Actualizar gráfica de anillo (solo 2 materiales)
                const normal = Math.floor(Math.random() * 30) + 60; // 60% - 90%
                const aceites = 100 - normal;
                doughnutChartInstance.data.datasets[0].data = [normal, aceites];
                doughnutChartInstance.update();

                // Actualizar métricas texto (Dashboard interactivo real)
                const nuevosUsados = Math.floor(Math.random() * 2000 + 3000);
                const meta = 5000;
                const porcentaje = (nuevosUsados / meta) * 100;
                document.getElementById('metric-stickers').innerHTML = nuevosUsados + ' <span class="text-muted fs-6 fw-normal">/ ' + meta + '</span>';
                document.getElementById('metric-stickers-progress').style.width = porcentaje + '%';

                const nuevoAcumulado = Math.floor(Math.random() * 500 + 800);
                document.getElementById('metric-acumulado').innerHTML = nuevoAcumulado + ' <span class="text-muted fs-6 fw-normal">Und.</span>';
                
                const randomTrend = Math.floor(Math.random() * 20) - 5;
                if (randomTrend >= 0) {
                    document.getElementById('metric-acumulado-trend').innerHTML = '<i class="fa-solid fa-arrow-trend-up me-1"></i> ' + randomTrend + '% más que ayer';
                    document.getElementById('metric-acumulado-trend').className = 'mt-2 text-success';
                } else {
                    document.getElementById('metric-acumulado-trend').innerHTML = '<i class="fa-solid fa-arrow-trend-down me-1"></i> ' + Math.abs(randomTrend) + '% menos que ayer';
                    document.getElementById('metric-acumulado-trend').className = 'mt-2 text-warning';
                }

                document.getElementById('metric-reimpresiones').innerHTML = Math.floor(Math.random() * 15) + ' <span class="text-muted fs-6 fw-normal">Alertas</span>';
                
                const repDia = Math.floor(Math.random() * 50 + 50);
                document.getElementById('metric-reimpresiones-dia').innerHTML = repDia + ' <span class="text-muted fs-6 fw-normal">Und.</span>';
                
                const repMes = Math.floor(Math.random() * 500 + 1500);
                document.getElementById('metric-reimpresiones-mes').innerHTML = repMes + ' <span class="text-muted fs-6 fw-normal">Und.</span>';
            }, 600);
        }
    </script>
}
