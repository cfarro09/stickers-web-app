@{
    ViewData["Title"] = "Configuración del Sistema";
    var currentRole = Context.Request.Query["role"].ToString();
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
        <h2 class="h3 mb-1 fw-bold text-dark">Configuración General</h2>
        <p class="text-muted mb-0"><i class="fa-solid fa-gears me-1"></i> Gestión de parámetros y maestros</p>
    </div>
    <button class="btn btn-primary fw-bold" onclick="showToast('Configuración guardada', 'success')">Guardar Cambios</button>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="list-group shadow-sm border-0">
            <a href="/admin/settings?role=@currentRole" hx-get="/admin/settings?role=@currentRole" hx-target="#main-content-container" hx-push-url="true" class="list-group-item list-group-item-action active py-3 border-0 border-bottom">
                <i class="fa-solid fa-server me-2"></i> Parámetros WMS
            </a>
            <a href="/admin/users?role=@currentRole" hx-get="/admin/users?role=@currentRole" hx-target="#main-content-container" hx-push-url="true" class="list-group-item list-group-item-action py-3 border-0 border-bottom text-secondary">
                <i class="fa-solid fa-users me-2"></i> Gestión de Usuarios
            </a>
            <a href="#" class="list-group-item list-group-item-action py-3 border-0 border-bottom text-muted">
                <i class="fa-solid fa-bell me-2"></i> Reglas de Alertas
            </a>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4">Parámetros del Agente de Impresión</h5>
                <form>
                    <div class="mb-3">
                        <label class="form-label fw-bold">URL API de Impresión</label>
                        <input type="text" class="form-control" value="http://192.168.1.100:8080/api/print">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Timeout de Respuesta (ms)</label>
                        <input type="number" class="form-control" value="5000">
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Puerto del Agente</label>
                            <input type="text" class="form-control" value="9100">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Reintentos Automáticos</label>
                            <input type="number" class="form-control" value="3">
                        </div>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" checked>
                        <label class="form-check-label">Habilitar logs de depuración (Debug Mode)</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" checked>
                        <label class="form-check-label">Notificar fallas críticas por Email</label>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
