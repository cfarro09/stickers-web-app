<!-- Modal para Nuevo Usuario -->
<div class="modal fade" id="newUserModal" tabindex="-1" aria-labelledby="newUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold" id="newUserModalLabel"><i class="fa-solid fa-user-plus text-primary me-2"></i> Crear Nuevo Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small text-uppercase">Nombres</label>
                            <input type="text" class="form-control" placeholder="Ej. Roberto">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-muted small text-uppercase">Apellidos</label>
                            <input type="text" class="form-control" placeholder="Ej. Sánchez">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Correo Electrónico (Crosland)</label>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="usuario">
                            <span class="input-group-text bg-light text-muted">@@crosland.pe</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Rol del Sistema</label>
                        <select class="form-select">
                            <option selected disabled>Seleccionar rol...</option>
                            <option value="1">Administrador IT</option>
                            <option value="2">Supervisor Logístico</option>
                            <option value="3">Operador Logístico</option>
                            <option value="4">Supervisor Comercial</option>
                            <option value="5">Visualizador Comercial</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Asignación Operativa</label>
                        <select class="form-select">
                            <option value="0">Sin asignación fija</option>
                            <option value="1">Línea Principal</option>
                            <option value="2">Mesa A1</option>
                            <option value="3">Mesa B2</option>
                        </select>
                    </div>
                    <div class="alert alert-info border-0 bg-primary bg-opacity-10 d-flex align-items-center mb-0" role="alert">
                        <i class="fa-solid fa-circle-info fs-5 text-primary me-3"></i>
                        <div>
                            <small class="d-block text-dark">Se enviará un correo con instrucciones para que el usuario configure su contraseña inicial.</small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-top-0">
                <button type="button" class="btn btn-outline-secondary fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary fw-bold" onclick="showToast('Usuario creado exitosamente. Se ha enviado el correo de invitación.', 'success'); var m = bootstrap.Modal.getInstance(document.getElementById('newUserModal')); m.hide();">
                    <i class="fa-solid fa-save me-1"></i> Guardar Usuario
                </button>
            </div>
        </div>
    </div>
</div>
