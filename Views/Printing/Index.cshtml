@functions {
    public class OrdenMock
    {
        public string IdOrden { get; set; } = "";
        public string Cliente { get; set; } = "";
        public string TipoMaterial { get; set; } = "";
        public int Cantidad { get; set; }
        public string Estado { get; set; } = ""; // "Completado", "Pendiente", "Error"
        public string NumImpresora { get; set; } = "";
        public string NumPedido { get; set; } = "";
    }
}
@{
    ViewData["Title"] = "Módulo de Impresiones";
    var currentRole = Context.Request.Query["role"].ToString();
    if (string.IsNullOrEmpty(currentRole)) currentRole = "Supervisor"; 

    var ordenes = new List<OrdenMock>
    {
        new OrdenMock { IdOrden = "LPN-0099821", Cliente = "Supermercados Global S.A.", TipoMaterial = "Estándar (Normal)", Cantidad = 150, Estado = "Completado", NumImpresora = "PRN-01", NumPedido = "PED-2026-8801" },
        new OrdenMock { IdOrden = "LPN-0099822", Cliente = "Logística Andina EIRL", TipoMaterial = "Resistente a Aceites (Reforzado)", Cantidad = 45, Estado = "Pendiente", NumImpresora = "PRN-02", NumPedido = "PED-2026-8802" },
        new OrdenMock { IdOrden = "LPN-0099823", Cliente = "Exportaciones Agrícolas SAC", TipoMaterial = "Estándar (Normal)", Cantidad = 500, Estado = "Error", NumImpresora = "PRN-01", NumPedido = "PED-2026-8803" },
        new OrdenMock { IdOrden = "LPN-0099824", Cliente = "TechCorp Inc.", TipoMaterial = "Resistente a Aceites (Reforzado)", Cantidad = 12, Estado = "Pendiente", NumImpresora = "PRN-03", NumPedido = "PED-2026-8804" },
        new OrdenMock { IdOrden = "LPN-0099825", Cliente = "Ferretería Industrial", TipoMaterial = "Estándar (Normal)", Cantidad = 80, Estado = "Completado", NumImpresora = "PRN-02", NumPedido = "PED-2026-8805" }
    };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
    <div>
        <h2 class="h3 mb-1 fw-bold text-dark">Módulo de Impresiones</h2>
        <p class="text-muted mb-0"><i class="fa-solid fa-barcode me-1"></i> Escaneo y generación de etiquetas</p>
    </div>
</div>

<!-- Buscador Principal (Solo Filtrado Local) -->
<div class="card shadow-sm border-0 mb-4 bg-primary text-white">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-filter me-2"></i>Filtrar Cola de Impresión</h5>
        <div class="input-group input-group-lg shadow-sm">
            <span class="input-group-text bg-white border-0 text-primary" id="search-icon"><i class="fa-solid fa-magnifying-glass fa-lg"></i></span>
            <input type="text" id="queueSearchInput" class="form-control border-0 text-dark fw-bold" style="font-size: 1.2rem;" placeholder="Escriba para filtrar por LPN, Pedido, Cliente o Impresora..." aria-label="Filtrar Cola" aria-describedby="search-icon" onkeyup="filterQueueTable()" autofocus>
        </div>
        <small class="mt-2 d-block text-white-50"><i class="fa-solid fa-circle-info me-1"></i>Este buscador filtra en tiempo real los registros cargados en la cola local de este equipo. No procesa lecturas externas.</small>
    </div>
</div>

<!-- Tabla de Datos -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="m-0 fw-bold text-dark"><i class="fa-solid fa-list-check me-2 text-primary"></i>Órdenes en Cola de Trabajo</h6>
        <button class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-filter me-1"></i> Filtros Avanzados</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover table-striped align-middle mb-0" id="queueTable">
                <thead class="table-light text-secondary" style="font-size: 0.85rem;">
                    <tr>
                        <th class="ps-4 py-3">LPN / ORDEN</th>
                        <th class="py-3">N° PEDIDO</th>
                        <th class="py-3">CLIENTE</th>
                        <th class="py-3">N° IMPRESORA</th>
                        <th class="py-3">MATERIAL</th>
                        <th class="text-center py-3">CANTIDAD</th>
                        <th class="text-center py-3">ESTADO</th>
                        <th class="text-center pe-4 py-3">ACCIONES</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var orden in ordenes)
                    {
                        <tr>
                            <td class="ps-4 py-2 fw-bold text-dark search-lpn">
                                <i class="fa-solid fa-box text-muted me-2"></i>@orden.IdOrden
                            </td>
                            <td class="py-2 fw-semibold search-pedido">@orden.NumPedido</td>
                            <td class="py-2 text-truncate search-cliente" style="max-width: 180px;">@orden.Cliente</td>
                            <td class="py-2 font-monospace small search-impresora"><i class="fa-solid fa-print me-1 text-secondary"></i>@orden.NumImpresora</td>
                            <td class="py-2"><span class="badge bg-light text-dark border"><i class="fa-solid fa-scroll me-1"></i>@orden.TipoMaterial</span></td>
                            <td class="text-center py-2 fw-bold">@orden.Cantidad</td>
                            <td class="text-center py-2">
                                @if (orden.Estado == "Completado")
                                {
                                    <span class="badge bg-success rounded-pill px-3 shadow-sm"><i class="fa-solid fa-check me-1"></i>Impreso</span>
                                }
                                else if (orden.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 shadow-sm"><i class="fa-solid fa-clock me-1"></i>Pendiente</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 shadow-sm"><i class="fa-solid fa-triangle-exclamation me-1"></i>Error</span>
                                }
                            </td>
                            <td class="text-center pe-4 py-2">
                                <div class="btn-group shadow-sm" role="group">
                                    <button type="button" class="btn btn-sm btn-primary fw-bold" onclick="showToast('Enviando a impresora orden @orden.IdOrden...', 'success')" @(orden.Estado == "Completado" ? "disabled" : "")>
                                        <i class="fa-solid fa-print"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-dark" title="Solicitar Reimpresión" onclick="openReprintModal('@orden.IdOrden')">
                                        <i class="fa-solid fa-rotate-right"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted" style="font-size: 0.85rem;">Mostrando 5 de 24 registros</span>
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item disabled"><a class="page-link" href="#">Anterior</a></li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#">Siguiente</a></li>
            </ul>
        </nav>
    </div>
</div>

<!-- Modal para Solicitar Reimpresión -->
<div class="modal fade" id="reprintModal" tabindex="-1" aria-labelledby="reprintModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold" id="reprintModalLabel"><i class="fa-solid fa-rotate-right text-warning me-2"></i> Solicitar Reimpresión</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="reprintLpn">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small text-uppercase">LPN / Orden Seleccionado</label>
                    <input type="text" id="reprintLpnDisplay" class="form-control bg-light fw-bold text-dark border-2" readonly>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small text-uppercase">Motivo de Reimpresión</label>
                    <select id="reprintReason" class="form-select border-2" required>
                        <option value="" selected disabled>Seleccione el motivo...</option>
                        <option value="Dañada">Etiqueta física dañada / arrugada</option>
                        <option value="Error Impresion">Error de impresión (corte/ribbon/tinta)</option>
                        <option value="Datos incorrectos">Actualización/Cambio de datos del pedido</option>
                        <option value="Perdida">Pérdida de etiqueta en tránsito</option>
                        <option value="Otro">Otro motivo</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted small text-uppercase">Prioridad de Solicitud</label>
                    <select id="reprintPriority" class="form-select border-2" required>
                        <option value="Baja">Baja - Cola regular</option>
                        <option value="Media" selected>Media - Normal</option>
                        <option value="Alta">Alta - Crítica / Despacho Inmediato</option>
                    </select>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted small text-uppercase">Observaciones adicionales</label>
                    <textarea id="reprintNotes" class="form-control border-2" rows="3" placeholder="Escriba aquí detalles relevantes para el supervisor..."></textarea>
                </div>
                <button type="button" onclick="submitReprintRequest()" class="btn btn-warning w-100 py-2.5 fw-bold shadow-sm text-dark d-flex align-items-center justify-content-center">
                    <i class="fa-solid fa-paper-plane me-2"></i> Enviar Solicitud de Reimpresión
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Función para filtrar la tabla de órdenes en tiempo real
    function filterQueueTable() {
        const input = document.getElementById("queueSearchInput");
        const filter = input.value.toLowerCase().trim();
        const table = document.getElementById("queueTable");
        const rows = table.getElementsByTagName("tbody")[0].getElementsByTagName("tr");

        for (let i = 0; i < rows.length; i++) {
            const row = rows[i];
            const lpn = row.querySelector(".search-lpn").textContent.toLowerCase();
            const pedido = row.querySelector(".search-pedido").textContent.toLowerCase();
            const cliente = row.querySelector(".search-cliente").textContent.toLowerCase();
            const impresora = row.querySelector(".search-impresora").textContent.toLowerCase();

            if (lpn.includes(filter) || pedido.includes(filter) || cliente.includes(filter) || impresora.includes(filter)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        }
    }

    // Abrir Modal de Reimpresión
    function openReprintModal(lpn) {
        document.getElementById('reprintLpn').value = lpn;
        document.getElementById('reprintLpnDisplay').value = lpn;
        document.getElementById('reprintReason').value = "";
        document.getElementById('reprintNotes').value = "";
        document.getElementById('reprintPriority').value = "Media";
        
        const myModal = new bootstrap.Modal(document.getElementById('reprintModal'));
        myModal.show();
    }

    // Enviar Solicitud de Reimpresión
    function submitReprintRequest() {
        const lpn = document.getElementById('reprintLpn').value;
        const reason = document.getElementById('reprintReason').value;
        const priority = document.getElementById('reprintPriority').value;
        
        if (!reason) {
            showToast('Por favor seleccione un motivo de reimpresión', 'warning');
            return;
        }

        // Cerrar modal de forma segura usando bootstrap
        const modalEl = document.getElementById('reprintModal');
        const modalInstance = bootstrap.Modal.getInstance(modalEl);
        if (modalInstance) {
            modalInstance.hide();
        }

        // Obtener el rol desde C# Razor
        const currentRole = '@currentRole';
        
        if (currentRole === 'Operador') {
            showToast(`Solicitud de reimpresión para ${lpn} (Prioridad ${priority}) enviada a aprobación del Supervisor`, 'warning');
        } else {
            showToast(`Reimpresión para ${lpn} (Prioridad ${priority}) procesada con éxito`, 'success');
        }
    }
</script>
