## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto-generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you have tasks that create toplevel databases
# *.db

# MSTest test Results
[T]est[R]esult*/
[Bb]uild[L]og.*

# NUNIT
CompileLog.txt

# OLAP Key files
*.key

# User-specific project settings inside NUnit 3.x project files
*.nunit.user

# ASP.NET Core light-weight development database for IIS Express
App_Data/*.mdf
App_Data/*.ldf

# Nested environments (e.g. docs build)
.env
.venv
env/
venv/

# Visual Studio Code
.vscode/

# Rider
.idea/

# Local settings
appsettings.json
!appsettings.Development.json
!appsettings.json
